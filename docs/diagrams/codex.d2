title: Codex source adapter

root: {
  label: "Sensitive data: Root\n~/.codex"
  class: sensitive
}

index: {
  label: "Sensitive data: Threads index\n~/.codex/state_5.sqlite\nopened read-only, directly\n(no snapshot copy)\nquery: id, rollout_path, parent_id, cwd\nfrom table threads"
  class: sensitive
}

bug: {
  label: "Known bug BOTSPY-81143b\nthe real threads table has no\nparent_id column. The query fails,\nthe adapter swallows the error,\nreal installs report 0 sessions"
  class: tool
}

rollouts: {
  label: "Sensitive data: Rollout files\n~/.codex/sessions/YYYY/MM/DD/\nrollout-*.jsonl\none file per session"
  class: sensitive
}

missing: {
  label: "Missing rollout file\nskipped and counted"
  class: tool
}

parents: {
  label: "Spawn edges\nparent links in the session graph\n(the real DB keeps them in\nthread_spawn_edges; the query's\nparent_id column is absent today)"
  class: tool
}

adapter: {
  label: "CodexSource\nrollout byte offsets in memory,\nresume per session,\npartial trailing line held back"
  class: tool
}

ordering: {
  label: "Ordering\nEvery record has an explicit\nordinal field. Records are sorted\nby ordinal, not by file order."
  class: tool
}

mapping: {
  label: "Record mapping\n\nresponse_item, message user / assistant → Text\nresponse_item, message developer       → System part (origin: developer)\nresponse_item, reasoning summary       → Thinking\nfunction_call                          → ToolCall (arguments parsed)\nfunction_call_output                   → ToolResult (role: tool)\ntoken_usage_record                     → Usage (model, token counts)\ncompacted                              → CompactionWindow\ntask_complete                         → Turn (duration, time to first token)"
  class: tool
}

session: {
  label: "Unified Session\nmessages, parts, usage,\nparent links, provenance"
  class: tool
}

root -> index: "reads thread list"
index -> rollouts: "rollout_path per thread\n(absolute or relative)"
rollouts -> adapter: "read record by record"
index -> missing: "thread without a rollout file"
index -> bug: "query error swallowed\n(unwrap_or_default)"
adapter -> ordering: "sorts by ordinal"
ordering -> mapping: "each record type"
mapping -> session: "extracted"
index -> parents: "parent_id column"
parents -> session: "session graph"